# Tooling image for the documentation and the static checks (tests/container/run.sh). It runs no appjail jail: anything
# that needs a kernel feature stays in the qemu guests (docs/develop/testing.md). Build context: the repository root.
FROM docker.io/library/debian:13-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip python3-pytest git reuse ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY .github/requirements-docs.txt .github/requirements-ruff.txt /tmp/
RUN python3 -m venv /opt/docs-venv \
 && /opt/docs-venv/bin/pip install -q --no-input --require-hashes --only-binary=:all: -r /tmp/requirements-docs.txt \
 && PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install -q --no-input -r /tmp/requirements-ruff.txt \
 && rm -f /tmp/requirements-*.txt
ENV HOME=/tmp/home PATH=/opt/docs-venv/bin:/usr/local/bin:/usr/bin:/bin
WORKDIR /src
