{
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(./.claude/**)",
      "Edit(./.git/**)",
      "Edit(./.githooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/host_exec_guard.py\""
          }
        ]
      }
    ]
  }
}
